# CardioLens Environment Configuration
# Copy this file to .env for local overrides (never commit secrets to version control)

# Application Environment (development | production)
NODE_ENV=production

# Base Application URL
VITE_APP_URL=http://localhost:3000

# Rate Limiting Thresholds (requests per window)
VITE_RATE_LIMIT_WINDOW_MS=60000
VITE_RATE_LIMIT_MAX_REQUESTS=45

# Session Inactivity Timeout (minutes)
VITE_SESSION_TIMEOUT_MINUTES=30
